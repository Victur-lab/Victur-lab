# Par de mercado na SafeTrade (minusculo, sem hifen). Ex.: prlusdt
MARKET=prlusdt

# URL do ticker publico da SafeTrade. Ajuste se o endpoint mudar.
SAFETRADE_TICKER_URL=https://safetrade.com/api/v2/peatio/public/markets/{market}/tickers

# Intervalo entre notificacoes, em minutos
INTERVAL_MINUTES=5

# Numero de WhatsApp que vai RECEBER as notificacoes (formato internacional, so digitos)
# Ex.: 5511999998888
WHATSAPP_PHONE=

# Apikey gerada pelo CallMeBot (veja README.md para o passo a passo)
WHATSAPP_APIKEY=
